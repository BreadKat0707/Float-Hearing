<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Float_Hearing.Pages.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Float_Hearing.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16">
            <Border
                Width="120"
                Height="120"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="36"
                    Glyph="&#xE8FD;" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind PlaylistName, Mode=OneWay}" />
                <TextBlock
                    Opacity="0.7"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Subtitle, Mode=OneTime}" />
            </StackPanel>
        </StackPanel>

        <TextBlock
            Grid.Row="2"
            Opacity="0.6"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="{x:Bind Hint, Mode=OneTime}" />
    </Grid>
</Page>
