<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Float_Hearing.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <!-- 全宽布局：SettingsCard 随窗口拉伸 -->
    <ScrollViewer Padding="24,20,24,20">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind Title, Mode=OneTime}" />

            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind AppearanceLabel, Mode=OneTime}" />

            <!-- 主题：HeaderIcon + 右侧 ComboBox（对齐系统设置样式） -->
            <toolkit:SettingsCard
                Header="{x:Bind ThemeLabel, Mode=OneTime}"
                Description="{x:Bind ThemeDescription, Mode=OneTime}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="ThemeSelector"
                    MinWidth="160"
                    HorizontalAlignment="Right"
                    SelectionChanged="ThemeSelector_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind ThemeSystemLabel, Mode=OneTime}" Tag="System" />
                    <ComboBoxItem Content="{x:Bind ThemeLightLabel, Mode=OneTime}" Tag="Light" />
                    <ComboBoxItem Content="{x:Bind ThemeDarkLabel, Mode=OneTime}" Tag="Dark" />
                </ComboBox>
            </toolkit:SettingsCard>

            <!-- 背景类型 -->
            <toolkit:SettingsExpander
                Header="{x:Bind BackgroundLabel, Mode=OneTime}"
                Description="{x:Bind BackgroundDescription, Mode=OneTime}"
                IsExpanded="True">
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header="{x:Bind BackgroundModeLabel, Mode=OneTime}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="BackgroundModeSelector"
                            MinWidth="200"
                            HorizontalAlignment="Right"
                            SelectionChanged="BackgroundModeSelector_SelectionChanged">
                            <ComboBoxItem Content="{x:Bind BgSolid, Mode=OneTime}" Tag="Solid" />
                            <ComboBoxItem Content="{x:Bind BgMica, Mode=OneTime}" Tag="Mica" />
                            <ComboBoxItem Content="{x:Bind BgMicaAlt, Mode=OneTime}" Tag="MicaAlt" />
                            <ComboBoxItem Content="{x:Bind BgAcrylicBase, Mode=OneTime}" Tag="AcrylicBase" />
                            <ComboBoxItem Content="{x:Bind BgAcrylicThin, Mode=OneTime}" Tag="AcrylicThin" />
                            <ComboBoxItem Content="{x:Bind BgAcrylicDefault, Mode=OneTime}" Tag="AcrylicDefault" />
                            <ComboBoxItem Content="{x:Bind BgAcrylicCustom, Mode=OneTime}" Tag="AcrylicCustom" />
                            <ComboBoxItem Content="{x:Bind BgFluid, Mode=OneTime}" Tag="Fluid" />
                            <ComboBoxItem Content="{x:Bind BgImage, Mode=OneTime}" Tag="Image" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <!-- 失焦回退纯色（始终可见） -->
                    <toolkit:SettingsCard
                        x:Name="CardSolidWhenInactive"
                        Header="{x:Bind BgSolidWhenInactive, Mode=OneTime}"
                        Description="{x:Bind BgSolidWhenInactiveDescription, Mode=OneTime}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7F8;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="SolidWhenInactiveToggle"
                            IsOn="True"
                            Toggled="SolidWhenInactiveToggle_Toggled" />
                    </toolkit:SettingsCard>

                    <!-- Solid 颜色 -->
                    <toolkit:SettingsCard
                        x:Name="CardSolidColor"
                        Header="{x:Bind BgSolidColor, Mode=OneTime}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <TextBox
                            x:Name="SolidColorBox"
                            Width="120"
                            HorizontalAlignment="Right"
                            TextChanged="SolidColorBox_TextChanged" />
                    </toolkit:SettingsCard>

                    <!-- Acrylic Custom 参数 -->
                    <toolkit:SettingsCard
                        x:Name="CardAcrylicTint"
                        Header="{x:Bind BgAcrylicTint, Mode=OneTime}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                            <!-- 色块按钮：点开 ColorPicker -->
                            <Button
                                x:Name="AcrylicTintSwatch"
                                Width="40"
                                Height="32"
                                Padding="0"
                                ToolTipService.ToolTip="{x:Bind BgAcrylicTint, Mode=OneTime}">
                                <Button.Flyout>
                                    <Flyout>
                                        <!-- 透明度由独立滑条控制，ColorPicker 只改 RGB -->
                                        <ColorPicker
                                            x:Name="AcrylicTintPicker"
                                            IsAlphaEnabled="False"
                                            IsAlphaSliderVisible="False"
                                            IsAlphaTextInputVisible="False"
                                            IsHexInputVisible="True"
                                            IsMoreButtonVisible="False"
                                            ColorChanged="AcrylicTintPicker_ColorChanged" />
                                    </Flyout>
                                </Button.Flyout>
                                <Border
                                    x:Name="AcrylicTintSwatchBorder"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="White"
                                    CornerRadius="4" />
                            </Button>
                            <TextBox
                                x:Name="AcrylicTintBox"
                                Width="120"
                                VerticalAlignment="Center"
                                TextChanged="AcrylicTintBox_TextChanged" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        x:Name="CardAcrylicOpacity"
                        Header="{x:Bind BgAcrylicTintOpacity, Mode=OneTime}">
                        <Slider
                            x:Name="AcrylicOpacitySlider"
                            Width="200"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.05"
                            HorizontalAlignment="Right"
                            ValueChanged="AcrylicOpacitySlider_ValueChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        x:Name="CardAcrylicLum"
                        Header="{x:Bind BgAcrylicLuminosity, Mode=OneTime}">
                        <Slider
                            x:Name="AcrylicLumSlider"
                            Width="200"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.05"
                            HorizontalAlignment="Right"
                            ValueChanged="AcrylicLumSlider_ValueChanged" />
                    </toolkit:SettingsCard>

                    <!-- 图片：路径 / 压暗强度 / 深浅压暗色 / blur -->
                    <toolkit:SettingsCard
                        x:Name="CardImagePath"
                        Header="{x:Bind BgImagePath, Mode=OneTime}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE91B;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="{x:Bind BgPickImage, Mode=OneTime}"
                                Click="PickImage_Click" />
                            <TextBlock
                                x:Name="ImagePathText"
                                VerticalAlignment="Center"
                                Opacity="0.7"
                                TextTrimming="CharacterEllipsis"
                                MaxWidth="360" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        x:Name="CardImageDim"
                        Header="{x:Bind BgImageDim, Mode=OneTime}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE706;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Slider
                            x:Name="ImageDimSlider"
                            Width="200"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.05"
                            HorizontalAlignment="Right"
                            ValueChanged="ImageDimSlider_ValueChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        x:Name="CardImageDimDark"
                        Header="{x:Bind BgImageDimDark, Mode=OneTime}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE708;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                            <Button
                                x:Name="DimDarkSwatch"
                                Width="40"
                                Height="32"
                                Padding="0"
                                ToolTipService.ToolTip="{x:Bind BgImageDimDark, Mode=OneTime}">
                                <Button.Flyout>
                                    <Flyout>
                                        <ColorPicker
                                            x:Name="DimDarkPicker"
                                            IsAlphaEnabled="False"
                                            IsAlphaSliderVisible="False"
                                            IsAlphaTextInputVisible="False"
                                            IsHexInputVisible="True"
                                            IsMoreButtonVisible="False"
                                            ColorChanged="DimDarkPicker_ColorChanged" />
                                    </Flyout>
                                </Button.Flyout>
                                <Border
                                    x:Name="DimDarkSwatchBorder"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Black"
                                    CornerRadius="4" />
                            </Button>
                            <TextBox
                                x:Name="DimDarkBox"
                                Width="120"
                                VerticalAlignment="Center"
                                TextChanged="DimDarkBox_TextChanged" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        x:Name="CardImageDimLight"
                        Header="{x:Bind BgImageDimLight, Mode=OneTime}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE706;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                            <Button
                                x:Name="DimLightSwatch"
                                Width="40"
                                Height="32"
                                Padding="0"
                                ToolTipService.ToolTip="{x:Bind BgImageDimLight, Mode=OneTime}">
                                <Button.Flyout>
                                    <Flyout>
                                        <ColorPicker
                                            x:Name="DimLightPicker"
                                            IsAlphaEnabled="False"
                                            IsAlphaSliderVisible="False"
                                            IsAlphaTextInputVisible="False"
                                            IsHexInputVisible="True"
                                            IsMoreButtonVisible="False"
                                            ColorChanged="DimLightPicker_ColorChanged" />
                                    </Flyout>
                                </Button.Flyout>
                                <Border
                                    x:Name="DimLightSwatchBorder"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Black"
                                    CornerRadius="4" />
                            </Button>
                            <TextBox
                                x:Name="DimLightBox"
                                Width="120"
                                VerticalAlignment="Center"
                                TextChanged="DimLightBox_TextChanged" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        x:Name="CardImageBlur"
                        Header="{x:Bind BgImageBlur, Mode=OneTime}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE71E;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Slider
                            x:Name="ImageBlurSlider"
                            Width="200"
                            Minimum="0"
                            Maximum="50"
                            StepFrequency="1"
                            HorizontalAlignment="Right"
                            ValueChanged="ImageBlurSlider_ValueChanged" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <!-- 其它外观 -->
            <toolkit:SettingsExpander
                Header="{x:Bind AppearanceMoreLabel, Mode=OneTime}"
                Description="{x:Bind AppearanceMoreDescription, Mode=OneTime}"
                IsExpanded="False">
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        Header="{x:Bind PlayBarLabel, Mode=OneTime}"
                        Description="{x:Bind PlayBarDescription, Mode=OneTime}">
                        <ToggleSwitch x:Name="PlayBarToggle" IsOn="True" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
