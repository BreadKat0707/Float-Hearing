<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Float_Hearing.Controls.PlayBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        MinHeight="72"
        Padding="16,8">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 封面占位 -->
            <Border
                Grid.Column="0"
                Width="48"
                Height="48"
                CornerRadius="4"
                Background="{ThemeResource ControlFillColorSecondaryBrush}" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind TrackTitle, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind TrackArtist, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center">
                <Button
                    x:Name="BtnPrevious"
                    AutomationProperties.Name="{x:Bind PreviousLabel, Mode=OneTime}"
                    Click="BtnPrevious_Click">
                    <FontIcon FontSize="16" Glyph="&#xF8AC;" />
                </Button>
                <Button
                    x:Name="BtnPlayPause"
                    AutomationProperties.Name="{x:Bind PlayPauseLabel, Mode=OneTime}"
                    Click="BtnPlayPause_Click">
                    <FontIcon x:Name="GlyphPlayPause" FontSize="16" Glyph="&#xF5B0;" />
                </Button>
                <Button
                    x:Name="BtnNext"
                    AutomationProperties.Name="{x:Bind NextLabel, Mode=OneTime}"
                    Click="BtnNext_Click">
                    <FontIcon FontSize="16" Glyph="&#xF8AD;" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
