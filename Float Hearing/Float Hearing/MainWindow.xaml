<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Float_Hearing.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Float_Hearing"
    xmlns:controls="using:Float_Hearing.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Float Hearing"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 内置 TitleBar：返回/折叠为系统样式（无按钮底、带按压动效），对齐 WinUI Gallery -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="{x:Bind AppTitle, Mode=OneTime}"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="True"
            BackRequested="AppTitleBar_BackRequested"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///AppIcon.ico" />
            </TitleBar.IconSource>
            <StackPanel
                Orientation="Horizontal"
                Spacing="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,8,0">
                <!-- 右侧三枚：仅图标 + 悬浮提示（有按钮背景与按压反馈） -->
                <AppBarButton
                    x:Name="BtnMusicLibrary"
                    Click="BtnMusicLibrary_Click"
                    ToolTipService.ToolTip="{x:Bind NavMusicLibrary, Mode=OneTime}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="BtnSleepTimer"
                    Click="BtnSleepTimer_Click"
                    ToolTipService.ToolTip="{x:Bind NavSleepTimer, Mode=OneTime}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="BtnSettings"
                    Click="BtnSettings_Click"
                    ToolTipService.ToolTip="{x:Bind NavSettings, Mode=OneTime}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </StackPanel>
        </TitleBar>

        <!-- 主内容：NavigationView + 页框 -->
        <NavigationView
            x:Name="RootNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="260"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            Loaded="RootNav_Loaded"
            SelectionChanged="RootNav_SelectionChanged">

            <NavigationView.PaneHeader>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Margin="8,8,8,4"
                    QueryIcon="Find"
                    Text="{x:Bind SearchPlaceholder, Mode=OneTime}" />
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind NavSongs, Mode=OneTime}" Tag="Songs" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavAlbums, Mode=OneTime}" Tag="Albums">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavArtists, Mode=OneTime}" Tag="Artists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavGenres, Mode=OneTime}" Tag="Genres">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8CB;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavFolders, Mode=OneTime}" Tag="Folders">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavPlaylists, Mode=OneTime}" Tag="Playlists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem Content="{x:Bind NavRecent, Mode=OneTime}" Tag="Recent">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavStats, Mode=OneTime}" Tag="Stats">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem Content="{x:Bind NavIdeas, Mode=OneTime}" Tag="Ideas">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame
                x:Name="ContentFrame"
                Navigated="ContentFrame_Navigated" />
        </NavigationView>

        <!-- 底部 PlayBar -->
        <controls:PlayBar x:Name="PlayBar" Grid.Row="2" />
    </Grid>
</Window>
