<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Float_Hearing.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Float_Hearing"
    xmlns:controls="using:Float_Hearing.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Float Hearing"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- 背景层由 BackgroundService 插入 RootGrid 子级；ShellGrid 承载界面 -->
    <Grid x:Name="RootGrid">
        <Grid x:Name="ShellGrid" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 + 右侧命令叠层：命令右对齐并避开三大金刚（约 138px） -->
            <Grid Grid.Row="0">
                <toolkit:TitleBar
                    x:Name="AppTitleBar"
                    Title="{x:Bind AppTitle, Mode=OneTime}"
                    IsBackButtonVisible="True"
                    IsPaneButtonVisible="True"
                    DisplayMode="Tall"
                    AutoConfigureCustomTitleBar="True"
                    BackButtonClick="AppTitleBar_BackButtonClick"
                    PaneButtonClick="AppTitleBar_PaneButtonClick">
                    <toolkit:TitleBar.Icon>
                        <ImageIcon Source="ms-appx:///AppIcon.ico" />
                    </toolkit:TitleBar.Icon>
                </toolkit:TitleBar>

                <!-- 叠在标题栏右侧：Margin 右=金刚宽，紧贴最小化左侧 -->
                <StackPanel
                    x:Name="FooterPanel"
                    Orientation="Horizontal"
                    Spacing="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Margin="0,0,138,0">
                    <AppBarButton
                        x:Name="BtnMusicLibrary"
                        Style="{StaticResource TitleBarCmdButton}"
                        Click="BtnMusicLibrary_Click"
                        ToolTipService.ToolTip="{x:Bind NavMusicLibrary, Mode=OneTime}">
                        <AppBarButton.Icon>
                            <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="BtnRefreshLibrary"
                        Style="{StaticResource TitleBarCmdButton}"
                        Click="BtnRefreshLibrary_Click"
                        ToolTipService.ToolTip="{x:Bind NavMusicRefresh, Mode=OneTime}">
                        <AppBarButton.Icon>
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="BtnSleepTimer"
                        Style="{StaticResource TitleBarCmdButton}"
                        Click="BtnSleepTimer_Click"
                        ToolTipService.ToolTip="{x:Bind NavSleepTimer, Mode=OneTime}">
                        <AppBarButton.Icon>
                            <FontIcon FontSize="14" Glyph="&#xE823;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="BtnSettings"
                        Style="{StaticResource TitleBarCmdButton}"
                        Click="BtnSettings_Click"
                        ToolTipService.ToolTip="{x:Bind NavSettings, Mode=OneTime}">
                        <AppBarButton.Icon>
                            <FontIcon FontSize="14" Glyph="&#xE713;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="BtnMore"
                        Style="{StaticResource TitleBarCmdButton}"
                        Visibility="Collapsed"
                        Click="BtnMore_Click"
                        ToolTipService.ToolTip="{x:Bind TitleBarMore, Mode=OneTime}">
                        <AppBarButton.Icon>
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </StackPanel>
            </Grid>

        <!-- 主内容：NavigationView + 页框 -->
        <NavigationView
            x:Name="RootNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="260"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            Loaded="RootNav_Loaded"
            SelectionChanged="RootNav_SelectionChanged">

            <NavigationView.PaneHeader>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Margin="8,8,8,4"
                    QueryIcon="Find"
                    Text="{x:Bind SearchPlaceholder, Mode=OneTime}" />
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <!-- 第一组：音乐库 -->
                <NavigationViewItemHeader x:Name="HeaderLibrary" />
                <NavigationViewItem Content="{x:Bind NavSongs, Mode=OneTime}" Tag="Songs" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavAlbums, Mode=OneTime}" Tag="Albums">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE93C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavArtists, Mode=OneTime}" Tag="Artists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavGenres, Mode=OneTime}" Tag="Genres">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavFolders, Mode=OneTime}" Tag="Folders">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 第二组：听歌记录（含想法） -->
                <NavigationViewItemHeader x:Name="HeaderHistory" />
                <NavigationViewItem Content="{x:Bind NavRecent, Mode=OneTime}" Tag="Recent">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavStats, Mode=OneTime}" Tag="Stats">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEAFC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavIdeas, Mode=OneTime}" Tag="Ideas">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA80;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 第三组：歌单（首项=新建；其余运行时注入，可拖拽/右键） -->
                <NavigationViewItemHeader x:Name="HeaderPlaylists" />
                <NavigationViewItem
                    x:Name="NavItemNewPlaylist"
                    Content="{x:Bind NavNewPlaylist, Mode=OneTime}"
                    Tag="NewPlaylist">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Playlist nav items appended after this in code-behind -->
            </NavigationView.MenuItems>

            <Frame
                x:Name="ContentFrame"
                Navigated="ContentFrame_Navigated" />
        </NavigationView>

        <!-- 底部 PlayBar -->
        <controls:PlayBar x:Name="PlayBar" Grid.Row="2" />
        </Grid>
    </Grid>
</Window>
