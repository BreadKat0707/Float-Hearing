<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Float_Hearing.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Float_Hearing"
    xmlns:controls="using:Float_Hearing.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="FH Reborn"
    mc:Ignorable="d">

    <!-- Mica 暂注释：排查 CoreMessagingXP 启动崩溃；确认后再恢复 -->
    <!--
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    -->

    <Grid x:Name="RootGrid" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自定义 Tall 标题栏：返回 → 导航展开 → 图标+标题 -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="0,0,0,0"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BtnBack"
                Grid.Column="0"
                Width="40"
                Height="40"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Click="BtnBack_Click">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>

            <Button
                x:Name="BtnTogglePane"
                Grid.Column="1"
                Width="40"
                Height="40"
                VerticalAlignment="Center"
                Click="BtnTogglePane_Click">
                <FontIcon FontSize="14" Glyph="&#xE700;" />
            </Button>

            <StackPanel
                Grid.Column="2"
                Margin="8,0,0,0"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Image
                    Width="20"
                    Height="20"
                    Source="ms-appx:///AppIcon.ico" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind AppTitle, Mode=OneTime}" />
            </StackPanel>
        </Grid>

        <!-- 主内容：NavigationView + 页框 -->
        <NavigationView
            x:Name="RootNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="260"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            Loaded="RootNav_Loaded"
            SelectionChanged="RootNav_SelectionChanged">

            <NavigationView.PaneHeader>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Margin="8,8,8,4"
                    QueryIcon="Find"
                    Text="{x:Bind SearchPlaceholder, Mode=OneTime}" />
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind NavSongs, Mode=OneTime}" Tag="Songs" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavAlbums, Mode=OneTime}" Tag="Albums">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavArtists, Mode=OneTime}" Tag="Artists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavGenres, Mode=OneTime}" Tag="Genres">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8CB;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavFolders, Mode=OneTime}" Tag="Folders">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem Content="{x:Bind NavRecent, Mode=OneTime}" Tag="Recent">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavStats, Mode=OneTime}" Tag="Stats">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavAnalytics, Mode=OneTime}" Tag="Analytics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem Content="{x:Bind NavIdeas, Mode=OneTime}" Tag="Ideas">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="{x:Bind NavSleepTimer, Mode=OneTime}" Tag="SleepTimer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind NavSettings, Mode=OneTime}" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame
                x:Name="ContentFrame"
                Navigated="ContentFrame_Navigated" />
        </NavigationView>

        <!-- 底部 PlayBar -->
        <controls:PlayBar x:Name="PlayBar" Grid.Row="2" />
    </Grid>
</Window>
